# Local React/FastAPI data. Keep this file free of credentials.
RAG_DATA_DIR=data
RAG_STORAGE_DIR=storage/qdrant
RAG_QDRANT_COLLECTION=rag_chunks
RAG_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
RAG_CHATGPT_RUNTIME_DIR=.run/chatgpt
RAG_TASK_MAX_CALLS=64
RAG_TASK_TIMEOUT_SECONDS=600
# Connect an authorized ChatGPT account in Settings; no API key is needed for that flow.
# Optional server API provider (store a real key only in your private .env):
# GEMINI_API_KEY=
